# LLM provider: Google Gemini API free tier.
# Create a free API key at https://aistudio.google.com/apikey
# The OpenAI-compatible endpoint uses that key as a bearer token.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Paste the Google AI Studio key here. GEMINI_API_KEY is also accepted.
LLM_API_KEY=

# GitHub access. Actions injects GITHUB_TOKEN.
GITHUB_TOKEN=
# Only needed if the official MCP server rejects the workflow token.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Review behaviour.
AGENT_TIMEOUT_SECONDS=90
JUDGE_CONFIDENCE_THRESHOLD=0.5
MAX_DIFF_LINES=800
DRY_RUN=false
LOG_LEVEL=INFO

# Optional MCP tool-name overrides after discovery.
# GITHUB_MCP_PR_TOOL=
# GITHUB_MCP_DIFF_TOOL=
# GITHUB_MCP_COMMENT_TOOL=

# Phase 1 spike only.
SPIKE_REPO=
SPIKE_PR=
